# Server environment variables
PORT=5000
NODE_ENV=development

# PostgreSQL (Supabase connection string)
DATABASE_URL=postgresql://user:password@host:5432/milestone

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Admin seed credentials (used by npm run seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Email (Gmail SMTP) — receipts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_EMAIL=owner@milestoneaccessories.co.tz

# Frontend URL (CORS + Stripe redirect)
CLIENT_URL=http://localhost:5173

# Payments: sandbox | stripe | snippe
PAYMENT_MODE=snippe

# ── Stripe (card payments) ──
# https://dashboard.stripe.com/apikeys
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_CURRENCY=usd
TZS_PER_USD=2600

# ── Snippe (Tanzania mobile money — M-Pesa, Airtel, Mixx, Halotel) ──
# Sign up at https://snippe.sh → Dashboard → Settings → API Keys
SNIPPE_API_KEY=snp_xxxxxxxxxxxxxxxx
# Webhook secret from Snippe Dashboard → Settings → Webhook Secret
SNIPPE_WEBHOOK_SECRET=your-webhook-signing-secret
# Webhook endpoint: https://YOUR_API_HOST/api/payments/webhook/snippe

# ── WhatsApp notifications (booking + order alerts to owner) ──
# Provider: "callmebot" (free) — sign up at https://www.callmebot.com/
#           "console" (dev fallback — logs to terminal)
WHATSAPP_PROVIDER=callmebot
# Get your API key from CallMeBot after registering your WhatsApp number
CALLMEBOT_API_KEY=your-callmebot-api-key
